<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 通话浮窗：浮在其他 App 上层（Android 6+ 需用户在系统设置里手动授予） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 通话浮窗前台服务：承载 TYPE_APPLICATION_OVERLAY，顺带把进程钉住，
         网页的语音播放与自动搭话在切到别的 App 后才不会被掐 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 通话按住说话/语音条录音、视频通话摄像头（WebView getUserMedia 需要壳侧转授） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 导出文件写公共「下载」目录：Android 10+ 走 MediaStore 免权限，仅 8/9 需要 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Health Connect：Android 13 及以下要单独装那个 App，这里声明它是为了
         在没装时能正确地「探测不到」而不是崩掉。Android 14+ 它已并入系统。 -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- 闹钟与倒计时：Android 11+ 有包可见性限制，不在 queries 里声明这两个
             意图，就「看不到」系统时钟 App，startActivity 会抛
             ActivityNotFoundException，被误报成「这台设备没有可用的时钟应用」。 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <!-- ══════ 深度陪伴扩展权限（仅本机自用，一次性开到位）══════
         说明：下面这些是「声明」。带 * 的属于危险权限，系统仍会弹窗由用户确认；
         声明只是让 App 有资格去申请。真正的授权入口见设置页的「权限中心」。
    -->

    <!-- 感知类：让角色知道我在用什么、在哪儿、什么状态 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- 健康数据（睡眠）：经 Health Connect 读，不是直接读厂商运动 App。
         这是 Health Connect 自己的权限（Android 14+ 由系统管），请求时由
         系统弹出授权，用户拒绝也不影响 App 其余部分。 -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- 日程与通讯录：角色记你的安排、认你的朋友 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 媒体：读相册/音乐，为后续「角色看照片、一起听歌」留口子 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 电话与短信：来电识别、通话状态感知 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- 系统能力：常驻、精确闹钟、设置项、状态栏 -->
    <!-- 设闹钟的**调用方权限**。系统时钟（AOSP 的 HandleSetAlarm、
         荣耀 com.hihonor.deskclock 等）给响应 SET_ALARM 的入口声明了
         android:permission="com.android.alarm.permission.SET_ALARM"。
         它是 normal 级权限：声明即自动授予，不需要用户手动开，但**不声明就没有**，
         startActivity 会抛：
           SecurityException: Permission Denial: starting Intent { act=android.intent.action.SET_ALARM
             ... requires com.android.alarm.permission.SET_ALARM
         （实测反馈，荣耀机型）。另外缺这个权限时 queryIntentActivities 也可能把
         时钟过滤掉，让 canHandleAlarmIntent 误报「本机不支持」。
         注意与下面的 SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM 区分：那两个是
         「本 App 自己定精确闹钟」用的，这个才是时钟 App 要求调用方持有的。 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 蓝牙与传感：耳机状态、贴贴等联动 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- 前台服务扩展类型（Android 14+ 要求逐项声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/appicon"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.FloatShell">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect 的权限说明页入口。Android 14+ 会在这里链一个
                 「为什么需要这些权限」的说明，缺了它系统会拒绝授权请求。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>

            <!-- 深链：外部 App（如桌宠）用 floatshell://open?url=<站内地址> 唤起本壳并直达指定页面。
                 目标地址仍受 SITE_URL 前缀校验，只能开自己的站点。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="floatshell" />
            </intent-filter>
        </activity>

        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.FloatShell" />

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <service
            android:name=".PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 查岗提醒闹钟：只发提醒通知，不在后台截屏；用户点开后才进入预览审批。 -->
        <receiver
            android:name=".CheckInAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".CheckInAccessibilitySettingsReceiver"
            android:exported="false" />

        <!-- 通话浮窗服务：TYPE_APPLICATION_OVERLAY 浮在其他 App 上层。
             mediaPlayback 类型同时把进程钉在前台，网页语音才不会被系统掐断。 -->
        <service
            android:name=".CallOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 查岗预览浮层：角色想看你时截屏先弹窗给你过目，你同意才发给它。
             用 specialUse：它不做媒体播放，只是可被用户看见的一次性确认浮层。 -->
        <service
            android:name=".CheckInService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户发起或明确同意的单次屏幕预览确认浮层" />
        </service>

        <!-- 截屏悬浮球：随手点一下就能截屏发给角色（你自己发起，不是角色查岗）。
             点击后交给 CheckInService 走同一套预览与审批。 -->
        <service
            android:name=".ScreenshotBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的屏幕截取悬浮球" />
        </service>

        <!-- 媒体控制：持有「通知使用权」后才有资格读活跃媒体会话、直接控制播放。
             它**不读任何通知内容**（onNotificationPosted 刻意不重写），存在的唯一
             目的是让 MediaSessionManager 认这个调用方。 -->
        <service
            android:name=".MediaControlListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 桌面小组件：角色留在桌面上的话。内容是网页渲染的图片（见 PhoneWidgetProvider）。 -->
        <receiver
            android:name=".PhoneWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/phone_widget_info" />
        </receiver>

        <!-- 浮窗通知上的动作按钮（挂断/返回） -->
        <receiver
            android:name=".OverlayActionReceiver"
            android:exported="false" />

        <!-- 通知栏「直接回复」：用户在消息通知横幅上就地回的话先落到这里，
             再转交网页的聊天引擎 -->
        <receiver
            android:name=".NotificationReplyReceiver"
            android:exported="false" />

        <!-- 通话控制无障碍服务：浮窗保活 + 前台 App 感知（需用户在系统设置里手动开启） -->
        <service
            android:name=".CallControlService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/call_control_service" />
        </service>
    </application>
</manifest>
